# Fin-Tracker Backend - Environment Variables Template
# Copy this file to /opt/fintracker/.env on your server
# DO NOT commit the actual .env file with real credentials to Git

#############################################
# Database Configuration
#############################################

# MySQL database host (usually localhost for single-server setup)
DB_HOST=localhost

# MySQL port (default: 3306)
DB_PORT=3306

# Database name
DB_NAME=fin_tracker

# Database username
DB_USERNAME=fintracker

# Database password (CHANGE THIS!)
DB_PASSWORD=your_secure_password_here

#############################################
# Application Configuration
#############################################

# Default currency for the application
# Examples: LKR, USD, EUR, GBP, INR
APP_DEFAULT_CURRENCY=LKR

# Spring profile to use
# Options: prod, dev, test
SPRING_PROFILES_ACTIVE=prod

#############################################
# JVM Configuration
#############################################

# JVM options for memory management
# Adjust based on available RAM:
#
# For 1GB RAM instance:
# JAVA_OPTS=-Xmx768m -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
#
# For 2GB RAM instance:
# JAVA_OPTS=-Xmx1536m -Xms1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
#
# For 4GB+ RAM instance:
# JAVA_OPTS=-Xmx2048m -Xms1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

JAVA_OPTS=-Xmx768m -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

#############################################
# Optional: Additional Spring Boot Properties
#############################################

# Server port (default: 8080)
# SERVER_PORT=8080

# Logging level
# LOGGING_LEVEL_ROOT=INFO

# Enable/disable actuator endpoints
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

#############################################
# Security Notes
#############################################

# 1. Keep this file secure with proper permissions:
#    chmod 600 /opt/fintracker/.env
#
# 2. Never commit this file to version control
#
# 3. Use strong passwords (minimum 16 characters)
#
# 4. Consider using a password manager or secret management service
#
# 5. Rotate passwords regularly
#
# 6. Back up this file securely (encrypted backup)
