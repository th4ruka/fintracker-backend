# Fin Tracker Backend Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
DB_USERNAME=fintracker_user
DB_PASSWORD=fintracker_password

# Application Configuration
APP_DEFAULT_CURRENCY=LKR

# Optional: Server Port (default is 8080)
# SERVER_PORT=8080

# Optional: Spring Profile
# SPRING_PROFILES_ACTIVE=dev
